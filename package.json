{
  "name": "aoe2-de-tools",
  "version": "1.0.0",
  "keywords": [
    "util",
    "functional",
    "server",
    "client",
    "browser"
  ],
  "author": "pete",
  "contributors": [],
  "dependencies": {
    "compression": "^1.8.1",
    "express": "5.2.1"
  },
  "scripts": {
    "prestart": "npm run build",
    "start": "node app.js",
    "dev": "npm start -- --open",
    "prebuild": "rm -rf public",
    "build": "npx @11ty/eleventy",
    "format:gamedata": "prettier --write src/data.json",
    "gamedata:extract": "python tools/gamedata/gamedata.py extract",
    "gamedata:verify": "python tools/gamedata/gamedata.py verify",
    "gamedata:update": "python tools/gamedata/gamedata.py update",
    "postgamedata:update": "npm run format:gamedata",
    "gamedata:freshness:audit": "node scripts/audit-gamedata-freshness.js",
    "techtree:verify": "python tools/gamedata/gamedata.py verify --techtree",
    "techtree:update": "python tools/gamedata/gamedata.py update --techtree",
    "posttechtree:update": "npm run format:gamedata && npm run build",
    "ranking:edit": "python tools/gamedata/ranking_editor.py"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.7",
    "prettier": "^2.4.1"
  },
  "prettier": {
    "tabWidth": 2,
    "semi": false,
    "singleQuote": true,
    "bracketSpacing": true,
    "printWidth": 80,
    "overrides": [
      {
        "files": "src/data.json",
        "options": {
          "parser": "json",
          "tabWidth": 4,
          "useTabs": false,
          "printWidth": 240,
          "bracketSpacing": false,
          "endOfLine": "crlf"
        }
      }
    ]
  }
}
